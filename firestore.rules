rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
      allow delete: if false;

      match /friends/{friendId} {
        allow read, write: if isUser(userId);
      }

      match /invites/{inviteId} {
        // Any authenticated player can send or update a friend invite where inviteId is their own UID
        allow create, update: if isAuthenticated() && request.auth.uid == inviteId;
        // The recipient can read, accept, or decline/delete the invite
        allow read, write: if isUser(userId);
      }

      match /match_invites/{matchInviteId} {
        // Any authenticated host can send a match challenge to this user
        allow create: if isAuthenticated() && request.resource.data.hostUid == request.auth.uid;
        // The recipient can read, update (to accept or decline), or delete
        allow read, write: if isUser(userId);
        // The host can read or update (to cancel)
        allow read, update: if isAuthenticated() && (resource == null || resource.data.hostUid == request.auth.uid);
      }
    }

    // Direct Friend Conversations
    match /conversations/{convId} {
      function isConvParticipant() {
        return isAuthenticated() && 
          (request.auth.uid in resource.data.participants);
      }

      allow read: if isAuthenticated() && (resource == null || isConvParticipant());
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && isConvParticipant();
      allow delete: if false;
    }

    // Match documents keyed by 6-character joinCode
    match /matches/{matchId} {

      function isParticipant() {
        return isAuthenticated() &&
          (request.auth.uid in resource.data.playerIds);
      }

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // 'player1' or 'player2' map key belonging to the caller.
      function myKey() {
        return request.auth.uid == resource.data.player1.uid ? 'player1' : 'player2';
      }

      // playerIds after the write == playerIds before, minus the caller.
      function removesOnlyMe() {
        return request.resource.data.playerIds.toSet() ==
          resource.data.playerIds.toSet().difference([request.auth.uid].toSet());
      }

      function isOpenForJoining() {
        return resource.data.status == 'waitingForOpponent';
      }

      // Player 2 claims the empty seat. Cannot touch scores, telemetry or config.
      function isJoining() {
        return isAuthenticated() &&
          isOpenForJoining() &&
          request.auth.uid != resource.data.player1.uid &&
          changedKeys().hasOnly(['player2', 'playerIds', 'status', 'activeTurnPlayerUid', 'updatedAt']) &&
          request.resource.data.player2.uid == request.auth.uid &&
          request.resource.data.status == 'active' &&
          request.resource.data.playerIds.size() == 2 &&
          request.resource.data.playerIds.hasAll([resource.data.player1.uid, request.auth.uid]) &&
          request.resource.data.activeTurnPlayerUid in [resource.data.player1.uid, request.auth.uid];
      }

      // The active shooter submits a round (transaction) or ticks the live score.
      // May only write their OWN player map, and only by appending one round.
      function isSubmittingTurn() {
        return isParticipant() &&
          resource.data.status in ['active', 'waitingForOpponent'] &&
          request.auth.uid == resource.data.activeTurnPlayerUid &&
          changedKeys().hasOnly([
            'currentRound', 'activeTurnPlayerUid', 'status', 'updatedAt', 'expireAt',
            'latestTelemetry', 'latestTelemetryRound', 'latestTelemetryShooterUid',
            'liveShooterScore', 'liveShooterUid', 'turnStartedAt',
            myKey()
          ]) &&
          request.resource.data.status in ['active', 'waitingForOpponent', 'completed'] &&
          request.resource.data.playerIds == resource.data.playerIds &&
          (!('turnStartedAt' in request.resource.data) ||
            !('turnStartedAt' in changedKeys()) ||
            request.resource.data.turnStartedAt == request.time) &&
          (!(myKey() in changedKeys()) || (
            request.resource.data[myKey()].uid == request.auth.uid &&
            request.resource.data[myKey()].roundScores.size() ==
              resource.data[myKey()].roundScores.size() + 1
          ));
      }

      // Lightweight chat-metadata mirror for inbox badges (messages live in the subcollection).
      function isTouchingTimestamp() {
        return isParticipant() &&
          changedKeys().hasOnly([
            'updatedAt',
            'lastChatSenderUid',
            'lastChatTimestamp',
            'lastChatText',
            'expireAt'
          ]);
      }

      // A participant resigns (pause menu FORFEIT, or LEAVE on an active match).
      function isForfeiting() {
        return isParticipant() &&
          resource.data.status in ['active', 'waitingForOpponent'] &&
          changedKeys().hasOnly(['status', 'forfeitedBy', 'winnerUid', 'activeTurnPlayerUid', 'updatedAt', 'expireAt', 'playerIds']) &&
          request.resource.data.status == 'forfeited' &&
          request.resource.data.forfeitedBy == request.auth.uid &&
          request.resource.data.winnerUid != request.auth.uid &&
          request.resource.data.winnerUid in resource.data.playerIds &&
          (request.resource.data.playerIds == resource.data.playerIds || removesOnlyMe());
      }

      // Spectator claims the win after the shooter abandoned a LIVE turn.
      // Server-verified: the shooter must have started this turn (turnStartedAt is a
      // server timestamp written on their first shot) and their full round clock
      // plus a 10s grace must have elapsed on Firestore's clock.
      function isClaimingAbandonedWin() {
        return isParticipant() &&
          resource.data.status == 'active' &&
          resource.data.activeTurnPlayerUid != request.auth.uid &&
          resource.data.activeTurnPlayerUid in resource.data.playerIds &&
          resource.data.get('liveShooterUid', '') == resource.data.activeTurnPlayerUid &&
          'turnStartedAt' in resource.data &&
          request.time > resource.data.turnStartedAt +
            duration.value(resource.data.roundDurationSeconds + 10, 's') &&
          changedKeys().hasOnly(['status', 'forfeitedBy', 'winnerUid', 'activeTurnPlayerUid', 'updatedAt', 'expireAt']) &&
          request.resource.data.status == 'forfeited' &&
          request.resource.data.forfeitedBy == resource.data.activeTurnPlayerUid &&
          request.resource.data.winnerUid == request.auth.uid;
      }

      // Host closes a room nobody has joined yet.
      function isAbandoningRoom() {
        return isParticipant() &&
          resource.data.status == 'waitingForOpponent' &&
          changedKeys().hasOnly(['playerIds', 'status', 'updatedAt']) &&
          request.resource.data.status == 'abandoned' &&
          removesOnlyMe();
      }

      // Removing a finished match from MY history (trash icon). The opponent keeps theirs.
      // expireAt may only be set once nobody references the match any more.
      function isDismissingFinished() {
        return isParticipant() &&
          resource.data.status in ['completed', 'forfeited', 'abandoned', 'declined'] &&
          changedKeys().hasOnly(['playerIds', 'updatedAt', 'expireAt']) &&
          removesOnlyMe() &&
          (!('expireAt' in changedKeys()) || request.resource.data.playerIds.size() == 0);
      }

      // Challenged friend declines. They are not in playerIds yet, so we verify
      // the challenge exists in their own match_invites inbox instead.
      function isDecliningChallenge() {
        return isAuthenticated() &&
          resource.data.status == 'waitingForOpponent' &&
          exists(/databases/$(database)/documents/users/$(request.auth.uid)/match_invites/$(matchId)) &&
          changedKeys().hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'declined';
      }

      // Read allowed if player is authenticated (non-existent codes return cleanly)
      allow read: if isAuthenticated();

      // Create allowed only for authenticated player as player1 with initial state
      allow create: if isAuthenticated() &&
        request.resource.data.player1.uid == request.auth.uid &&
        request.resource.data.playerIds == [request.auth.uid] &&
        request.resource.data.status == 'waitingForOpponent' &&
        request.resource.data.joinCode == matchId &&
        request.resource.data.currentRound == 1 &&
        request.resource.data.activeTurnPlayerUid == request.auth.uid &&
        request.resource.data.chat.size() == 0;

      allow update: if isJoining() ||
        isSubmittingTurn() ||
        isTouchingTimestamp() ||
        isForfeiting() ||
        isClaimingAbandonedWin() ||
        isAbandoningRoom() ||
        isDismissingFinished() ||
        isDecliningChallenge();

      // Matches are never hard-deleted by clients: finished matches are permanent
      // trophy history. Orphaned docs (no playerIds left) are cleaned by the expireAt TTL.
      allow delete: if false;

      // Lightweight real-time chat messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Real-time live shot streaming subcollection
      match /live_shots/{shotId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.shooterUid == request.auth.uid;
        allow update, delete: if false;
      }

      // Real-time live floating reactions & banter subcollection
      match /live_reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
