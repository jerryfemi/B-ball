{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|wasm|png|jpg|jpeg|webp|svg|woff|woff2|ttf|mp3|ogg|wav)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "game-arcade-bball",
          "appId": "1:30987418661:android:6b91d76128f407984293cc",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "game-arcade-bball",
          "configurations": {
            "android": "1:30987418661:android:6b91d76128f407984293cc",
            "ios": "1:30987418661:ios:f0fb3c643816dfbb4293cc",
            "macos": "1:30987418661:ios:f0fb3c643816dfbb4293cc",
            "web": "1:30987418661:web:f97ba9acaba086944293cc",
            "windows": "1:30987418661:web:c9f2ddc5f090efe24293cc"
          }
        }
      }
    }
  }
}